#!/usr/bin/env bash
# Vaultwarden behind Caddy (auto-HTTPS). Re-run to update; vault in ./data, certs in ./caddy.
# Router must forward WAN 80 + 443 to $LAN (cert validation + access).
set -euo pipefail
cd "$(dirname "$0")"
HOST=daoseeking.tplinkdns.com
LAN=192.168.1.216   # bind to the LAN IP: a wildcard :80 would clash with ryot on 127.0.0.2:80

docker network inspect vw >/dev/null 2>&1 || docker network create vw
docker pull vaultwarden/server:latest
docker pull caddy:2
docker rm -f vaultwarden vw-caddy 2>/dev/null || true

# Set SIGNUPS_ALLOWED=false and re-run once your account exists.
docker run -d --name vaultwarden --network vw --restart unless-stopped \
  -e DOMAIN="https://$HOST" \
  -e SIGNUPS_ALLOWED=true \
  -v "$PWD/data:/data" \
  vaultwarden/server:latest

docker run -d --name vw-caddy --network vw --restart unless-stopped \
  -p "$LAN:80:80" -p "$LAN:443:443" \
  -v "$PWD/caddy:/data" \
  caddy:2 caddy reverse-proxy --from "$HOST" --to vaultwarden:80
