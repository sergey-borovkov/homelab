# VPS Caddy: certs per host via HTTP-01 (ports 80/443 are open here, unlike at home).
# Front door: public home apps keep their own name and are forwarded to home Caddy over the direct path
# (<app>.home.daoseeking.uk:8443, router forward). Admin tools are not forwarded at all.
(home) {
	reverse_proxy https://{args[0]}.home.daoseeking.uk:8443
}

books.daoseeking.uk {
	import home books
}
jellyfin.daoseeking.uk {
	import home jellyfin
}
requests.daoseeking.uk {
	import home requests
}
auth.daoseeking.uk {
	import home auth
}
dash.daoseeking.uk {
	import home dash
}

# Apps running on the VPS itself
share.daoseeking.uk {
	reverse_proxy 127.0.0.1:3005
}
vault.daoseeking.uk {
	reverse_proxy 127.0.0.1:8222
}
budget.daoseeking.uk {
	reverse_proxy 127.0.0.1:5006
}
ryot.daoseeking.uk {
	reverse_proxy 127.0.0.1:8000
}
status.daoseeking.uk {
	reverse_proxy 127.0.0.1:3001
}

# Personal page (~/homelab/site, static)
daoseeking.uk {
	# / = the terminal (~/work/borovkov-term, Rust -> WebAssembly), /portfolio/ = the plain CV
	redir /term* /
	# same file names every build: always revalidate (ETag), so a new .js never meets an old .wasm
	header Cache-Control "no-cache"
	root * /srv/site
	encode zstd gzip
	file_server
}
www.daoseeking.uk {
	redir https://daoseeking.uk{uri} permanent
}
